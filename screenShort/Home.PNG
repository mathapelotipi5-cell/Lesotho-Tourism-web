    <title>Lesotho | Kingdom in the Sky</title>
  <script defer="" src="./Home_files/bundle.js.download"></script><style>:root {
  /* Green and white highland palette */
  --bg-canvas: #f0fdf4;
  --bg-card: #ffffff;
  --bg-header: #064e3b;

  --text-title: #064e3b;
  --text-body: #1e293b;
  --text-muted: #64748b;

  --border-subtle: #bbf7d0;
  --badge-bg: #ffffff;
  --badge-text: #064e3b;

  --btn-green: #064e3b;
  --btn-green-hover: #047857;
  --accent-light: #dcfce7;
  --accent-active: #a7f3d0;
}

/* Glabal resert & base */

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  background-color: var(--bg-canvas);
  color: var(--text-body);
  line-height: 1.6;
}

a {
  text-decoration: none;
  color: inherit;
}

button,
input,
select,
textarea {
  font-family: inherit;
}

/* Header and navigation*/

.header,
.site-header {
  background-color: var(--bg-header);
  color: #ffffff;
  padding: 16px 6%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  position: sticky;
  top: 0;
  z-index: 1000;
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}

.logo,
.site-header .brand {
  font-size: 20px;
  font-weight: 700;
  color: #ffffff;
  display: flex;
  align-items: center;
  gap: 10px;
}

.brand-mark {
  width: 34px;
  height: 34px;
  display: grid;
  place-items: center;
  border: 1px solid rgba(255, 255, 255, 0.4);
  border-radius: 50%;
  color: #ffffff;
  font-family: Georgia, serif;
  background-color: rgba(255, 255, 255, 0.08);
}

.site-header small {
  display: block;
  color: var(--accent-active);
  font-size: 9px;
  letter-spacing: 1px;
}

.nav,
.site-header nav {
  display: flex;
  align-items: center;
  gap: 24px;
  list-style: none;
}

.nav a,
.site-header nav a {
  color: #ecfdf5;
  font-size: 14px;
  font-weight: 500;
  transition: color 0.2s ease;
  position: relative;
  padding-bottom: 2px;
}

.nav a:hover,
.site-header nav a:hover {
  color: #6ee7b7;
}

/* Active Navbar Link Highlighting */
.site-header nav a.active {
  color: var(--accent-active) !important;
  font-weight: 700;
}

.site-header nav a.active::after {
  content: "";
  position: absolute;
  left: 0;
  bottom: -4px;
  width: 100%;
  height: 2px;
  background-color: var(--accent-active);
}

.header-cta {
  padding: 8px 16px;
  border: 1px solid rgba(255, 255, 255, 0.4);
  border-radius: 4px;
  transition: all 0.2s ease;
}

.header-cta:hover {
  border-color: #ffffff;
  background-color: rgba(255, 255, 255, 0.1);
}

.header-cta.active {
  background-color: var(--btn-green-hover) !important;
  border-color: var(--accent-active) !important;
  color: #ffffff !important;
  box-shadow: 0 0 8px rgba(167, 243, 208, 0.3);
}

/* White Hero section */

.hero {
  min-height: 460px;
  background-color: #ffffff;
  display: flex;
  justify-content: center;
  align-items: center;
  text-align: center;
  color: var(--text-title);
  padding: 60px 20px;
  position: relative;
  border-bottom: 1px solid var(--border-subtle);
}

.hero-content {
  max-width: 760px;
}

.hero h1 {
  font-family: Georgia, serif;
  font-size: clamp(2.8rem, 5vw, 4.5rem);
  font-weight: 400;
  line-height: 1.1;
  margin-bottom: 16px;
  color: var(--text-title);
}

.hero h1 em,
.intro h2 em,
.enquiry-intro h2 em {
  font-style: italic;
  color: #047857;
}

.hero p,
.hero .hero-copy {
  font-size: 1.15rem;
  color: var(--text-body);
  margin-bottom: 24px;
}

.hero-caption {
  position: absolute;
  right: 7%;
  bottom: 18px;
  left: 7%;
  display: flex;
  justify-content: space-between;
  color: var(--text-muted);
  font-size: 11px;
  letter-spacing: 1px;
}

/* Buttons */

.button,
.hero-button,
.button-light,
.button-dark {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background-color: var(--btn-green);
  color: #ffffff;
  padding: 12px 24px;
  border-radius: 4px;
  font-weight: 600;
  font-size: 14px;
  border: none;
  cursor: pointer;
  transition: background-color 0.2s ease, transform 0.2s ease;
}

.button:hover,
.hero-button:hover,
.button-light:hover,
.button-dark:hover {
  background-color: var(--btn-green-hover);
  transform: translateY(-1px);
}

/* Layout and Section */

.section-wrap,
.attractions-page {
  width: min(1160px, 92%);
  margin: 0 auto;
  padding: 48px 0;
}

.eyebrow {
  color: #047857;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 1.5px;
  text-transform: uppercase;
}

.section-title,
.welcome h2,
.intro h2,
.section-heading h2,
.experience-copy h2,
.enquiry-intro h2 {
  font-family: Georgia, serif;
  font-size: clamp(28px, 4vw, 42px);
  color: var(--text-title);
  margin: 12px 0;
  font-weight: 400;
  line-height: 1.2;
}

.intro-grid,
.section-heading {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 36px;
  align-items: center;
}

.fact-strip {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  margin-top: 40px;
  border-top: 1px solid var(--border-subtle);
  border-bottom: 1px solid var(--border-subtle);
  background-color: var(--bg-card);
  border-radius: 4px;
}

.fact-strip div {
  padding: 20px 16px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.fact-strip strong {
  color: var(--text-title);
  font: 26px Georgia, serif;
}

.fact-strip span,
.results-count {
  color: var(--text-muted);
  font-size: 13px;
}

/* Experience Band (Aligned) */

.experience-band {
  background-color: var(--accent-light);
  width: 100%;
  padding: 64px 0;
  margin-top: 48px;
}

.experience-copy {
  width: min(1160px, 92%);
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

/* Searsch and Filter */

.search-filter {
  display: flex;
  gap: 14px;
  margin: 28px 0 36px 0;
  flex-wrap: wrap;
}

.search-field,
.category-field,
.search-filter input,
.search-filter select {
  min-height: 46px;
  padding: 10px 14px;
  border: 1px solid var(--border-subtle);
  border-radius: 4px;
  font-size: 14px;
  background-color: var(--bg-card);
  color: var(--text-title);
  outline: none;
  transition: border-color 0.2s ease;
}

.search-field input,
.category-field select {
  border: 0;
  outline: 0;
  background: transparent;
  width: 100%;
}

.search-field {
  width: min(380px, 100%);
  display: flex;
  align-items: center;
  gap: 8px;
}

.category-field {
  min-width: 180px;
}

.search-filter input:focus,
.search-filter select:focus,
.search-field:focus-within,
.category-field:focus-within {
  border-color: var(--text-title);
}

/* Attraction Cards Grid */

.attractions-grid,
.attraction-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 28px;
}

.attraction-card {
  background-color: var(--bg-card);
  border: 1px solid var(--border-subtle);
  border-radius: 4px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transition: transform 0.25s ease, box-shadow 0.25s ease;
}

.attraction-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 12px 24px rgba(6, 78, 59, 0.08);
}

.card-visual {
  width: 100%;
  height: 220px;
  padding: 0;
  position: relative;
  overflow: hidden;
  border: 0;
  background-color: #dcfce7;
  cursor: pointer;
  text-align: left;
  display: block;
}

.card-visual img,
.attraction-card img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.35s ease;
}

.card-visual:hover img {
  transform: scale(1.03);
}

.card-category,
.attraction-category {
  position: absolute;
  top: 14px;
  right: 14px;
  background-color: var(--badge-bg);
  color: var(--badge-text);
  padding: 5px 10px;
  border-radius: 2px;
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.8px;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.12);
}

.card-number {
  display: none;
}

.attraction-content,
.attraction-card-content {
  padding: 24px 24px 20px 24px;
  display: flex;
  flex-direction: column;
  flex-grow: 1;
}

.location,
.attraction-location {
  color: var(--text-muted);
  font-size: 13px;
  margin-bottom: 8px;
  font-weight: 400;
}

.attraction-content h3,
.attraction-card h2 {
  font-family: Georgia, serif;
  font-size: 24px;
  font-weight: 400;
  color: var(--text-title);
  line-height: 1.25;
  margin-bottom: 12px;
}

.card-description,
.attraction-card p {
  color: var(--text-body);
  font-size: 14px;
  line-height: 1.6;
  margin-bottom: 24px;
  flex-grow: 1;
}

.card-meta {
  padding-top: 16px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-top: 1px solid var(--border-subtle);
  color: var(--text-muted);
  font-size: 13px;
}

/* Enquiry Form Section */

.enquiry-section {
  background-color: var(--accent-light);
  padding: 64px 6%;
  display: grid;
  grid-template-columns: 0.8fr 1.2fr;
  gap: 40px;
  align-items: start;
  border-radius: 4px;
  margin-top: 48px;
}

.enquiry-form {
  background-color: var(--bg-card);
  padding: 32px;
  border-radius: 4px;
  border: 1px solid var(--border-subtle);
}

.form-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px;
}

.form-field {
  display: flex;
  flex-direction: column;
  gap: 6px;
  font-size: 13px;
  font-weight: 600;
  color: var(--text-title);
}

.form-field input,
.form-field select,
.form-field textarea {
  width: 100%;
  padding: 10px 12px;
  border: 1px solid var(--border-subtle);
  border-radius: 4px;
  font-size: 14px;
  background-color: var(--bg-card);
  color: var(--text-title);
  outline: none;
}

.form-field textarea {
  min-height: 100px;
  resize: vertical;
}

.form-full {
  grid-column: 1 / -1;
}

.submit-button {
  background-color: var(--btn-green);
  color: #ffffff;
  padding: 12px 24px;
  border-radius: 4px;
  font-weight: 600;
  font-size: 14px;
  border: none;
  cursor: pointer;
  transition: background-color 0.2s ease;
  margin-top: 10px;
}

.submit-button:hover {
  background-color: var(--btn-green-hover);
}

.field-error {
  color: #dc2626;
  font-size: 12px;
  font-weight: 400;
}

.success-message {
  background-color: #d1fae5;
  color: #065f46;
  padding: 12px;
  border-radius: 4px;
  margin-bottom: 20px;
  text-align: center;
  font-size: 14px;
  border: 1px solid #a7f3d0;
}

/* Attraction Details Modal */

.details-overlay {
  position: fixed;
  inset: 0;
  z-index: 1001;
  padding: 20px;
  display: grid;
  place-items: center;
  background: rgba(6, 78, 59, 0.65);
  backdrop-filter: blur(2px);
}

.details-modal {
  width: min(640px, 100%);
  max-height: 90vh;
  overflow: auto;
  position: relative;
  background-color: var(--bg-card);
  padding: 36px;
  border-radius: 4px;
  border: 1px solid var(--border-subtle);
}

.details-image {
  display: block;
  width: calc(100% + 72px);
  height: 240px;
  margin: -36px -36px 28px;
  object-fit: cover;
}

.close-btn {
  width: 36px;
  height: 36px;
  position: absolute;
  top: 16px;
  right: 16px;
  border: 0;
  border-radius: 50%;
  background: var(--bg-canvas);
  color: var(--text-title);
  font-size: 20px;
  cursor: pointer;
}

/* Footer */

.footer {
  background-color: var(--bg-header);
  color: #ffffff;
  padding: 48px 6% 24px;
  margin-top: 60px;
}

.footer-inner {
  max-width: 1160px;
  margin: auto;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 32px;
}

.footer-section h4 {
  color: var(--accent-active);
  margin-bottom: 12px;
  font-size: 15px;
}

.footer-section > a:not(.brand) {
  display: block;
  margin: 8px 0;
  color: #ecfdf5;
  font-size: 14px;
}

.footer-section > a:not(.brand):hover {
  color: #6ee7b7;
}

.footer-bottom {
  max-width: 1160px;
  margin: 40px auto 0;
  padding-top: 20px;
  border-top: 1px solid rgba(255, 255, 255, 0.1);
  display: flex;
  justify-content: space-between;
  color: var(--accent-active);
  font-size: 13px;
}

/* Utilities and Accessibility */

.no-results {
  text-align: center;
  grid-column: 1 / -1;
  padding: 40px;
  color: var(--text-muted);
  font-size: 16px;
}

.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
}

/* Responsive Design*/

@media (max-width: 1000px) {
  .attractions-grid,
  .attraction-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 700px) {
  .header,
  .site-header {
    flex-direction: column;
    gap: 12px;
  }

  .nav,
  .site-header nav {
    gap: 16px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .enquiry-section {
    grid-template-columns: 1fr;
  }

  .attractions-grid,
  .attraction-grid {
    grid-template-columns: 1fr;
  }

  .search-filter {
    flex-direction: column;
  }

  .search-field,
  .category-field {
    width: 100%;
  }

  .form-grid {
    grid-template-columns: 1fr;
  }

  .footer-inner {
    grid-template-columns: 1fr;
  }

  .details-modal {
    padding: 24px;
  }

  .details-image {
    width: calc(100% + 48px);
    height: 190px;
    margin: -24px -24px 24px;
  }

  .hero-caption {
    gap: 8px;
    font-size: 9px;
  }

  .fact-strip {
    grid-template-columns: 1fr;
  }
}
/*# sourceMappingURL=data:application/json;base64, */</style><style>@import url(https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&display=swap);</style><style>html {
  min-width: 320px;
  background: #f5f5f5;
}

body {
  min-width: 320px;
  min-height: 100vh;
  margin: 0;
  font-family: 'DM Sans', 'Segoe UI', sans-serif;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

#root,
.app {
  min-height: 100vh;
}

code {
  font-family: source-code-pro, Menlo, Monaco, Consolas, 'Courier New',
    monospace;
}

/*# sourceMappingURL=data:application/json;base64, */</style></head>
  <body style="">
    <noscript>You need to enable JavaScript to run this app.</noscript>
    <div id="root"><div class="app"><header class="site-header"><a class="brand" href="http://localhost:3000/" aria-label="Lesotho Kingdom in the Sky home"><span class="brand-mark">L</span><span>LESOTHO <small>KINGDOM IN THE SKY</small></span></a><nav aria-label="Main navigation"><a href="http://localhost:3000/" class="active">Home</a><a href="http://localhost:3000/#about" class="">The Kingdom</a><a href="http://localhost:3000/#destinations" class="">Places</a><a href="http://localhost:3000/attractions" class="">Attractions</a><a href="http://localhost:3000/#enquiry" class="header-cta">Plan your visit</a></nav></header><main><section class="hero" id="home"><div class="hero-content"><p class="eyebrow">THE KINGDOM IN THE SKY</p><h1>Find your own<br><em>high ground.</em></h1><p class="hero-copy">Mountain mornings, winding passes and a warmth that stays with you. Welcome to Lesotho.</p><a class="button button-light" href="http://localhost:3000/#destinations">Explore the kingdom <span aria-hidden="true">↘</span></a></div><div class="hero-caption"><span>29° 36' S, 28° 14' E</span><span>THABA BOSIU · LESOTHO</span></div></section><section class="intro section-wrap" id="about"><p class="eyebrow">A COUNTRY ABOVE THE CLOUDS</p><div class="intro-grid"><h2>Small in size.<br><em>Endless in spirit.</em></h2><div class="intro-copy"><p>Completely surrounded by South Africa, Lesotho is the only country in the world that lies entirely above 1,000 metres. Its highlands are made for slow journeys: meet Basotho horsemen, follow the water to a hidden valley, and take the long way over the pass.</p><a class="text-link" href="http://localhost:3000/#destinations">Meet the places <span aria-hidden="true">→</span></a></div></div><div class="fact-strip"><div><strong>3,482 m</strong><span>Highest peak · Thabana Ntlenyana</span></div><div><strong>2.1 million</strong><span>People who call it home</span></div><div><strong>All year</strong><span>A reason to take the high road</span></div></div></section><section class="destinations section-wrap" id="destinations"><div class="section-heading"><div><p class="eyebrow">GO A LITTLE FURTHER</p><h2>Places with a pulse.</h2></div><div class="destination-heading-actions"><p>From ancient rock shelters to snow-dusted summits, find the Lesotho that calls to you.</p></div></div><div class="search-filter" role="search"><label class="search-field"><span aria-hidden="true">⌕</span><span class="sr-only">Search destinations</span><input placeholder="Search a place..." type="search" value=""></label><label class="category-field"><span class="sr-only">Filter by category</span><select><option value="All">All experiences</option><option value="Nature">Nature</option><option value="Culture">Culture</option><option value="Adventure">Adventure</option><option value="Historical">History</option></select></label></div><p class="results-count" aria-live="polite">8 places to explore</p><div class="attraction-grid"><article class="attraction-card"><button class="card-visual card-visual-nature" type="button" aria-label="View Maletsunyane Waterfalls details"><img alt="Maletsunyane Waterfalls in Lesotho" src="./Home_files/maletsunyane-waterfall.1b8fbc5a2c9b283d7139.jpg"><span class="card-category">Nature</span></button><div class="attraction-content"><p class="location">Semonkong, Maseru District</p><h3>Maletsunyane Waterfalls</h3><p class="card-description">A dramatic 192-metre single-drop waterfall plunging into a basalt gorge in the heart of the highlands.</p><div class="card-meta"><span>Abseiling</span><span>From M50 per person</span></div></div></article><article class="attraction-card"><button class="card-visual card-visual-culture" type="button" aria-label="View Thaba-Bosiu Cultural Village details"><img alt="Thaba-Bosiu Cultural Village in Lesotho" src="./Home_files/thaba-bosiu-cultural (1).75c518d3a0131af0b370.jpg"><span class="card-category">Culture</span></button><div class="attraction-content"><p class="location">Thaba-Bosiu, Maseru District</p><h3>Thaba-Bosiu Cultural Village</h3><p class="card-description">An historic mountain fortress established by King Moshoeshoe I, serving as the birthplace of the Basotho nation.</p><div class="card-meta"><span>Guided Heritage Tours</span><span>From M80 per person</span></div></div></article><article class="attraction-card"><button class="card-visual card-visual-adventure" type="button" aria-label="View Katse Dam details"><img alt="Katse Dam in Lesotho" src="./Home_files/katse-dam5.fbef0a7397a09058f166.jpg"><span class="card-category">Adventure</span></button><div class="attraction-content"><p class="location">Bokong, Thaba-Tseka District</p><h3>Katse Dam</h3><p class="card-description">An immense arch dam set among the Maluti Mountains, forming a major reservoir of the Lesotho Highlands Water Project.</p><div class="card-meta"><span>Dam Wall Tours</span><span>From M60 per person</span></div></div></article><article class="attraction-card"><button class="card-visual card-visual-historical" type="button" aria-label="View Liphofung Caves details"><img alt="Liphofung Caves in Lesotho" src="./Home_files/liphofung-cave1.ecc663eefe2bdbd2017a.jpg"><span class="card-category">Historical</span></button><div class="attraction-content"><p class="location">Butha-Buthe District</p><h3>Liphofung Caves</h3><p class="card-description">A historic sandstone shelter containing ancient San rock paintings and heritage displays detailing highland traditions.</p><div class="card-meta"><span>Rock Art Viewing</span><span>From M40 per person</span></div></div></article><article class="attraction-card"><button class="card-visual card-visual-nature" type="button" aria-label="View Bokong Nature Reserve details"><img alt="Bokong Nature Reserve in Lesotho" src="./Home_files/bokong-nature-reserve.1f9a3afec57e144f5d90.jpg"><span class="card-category">Nature</span></button><div class="attraction-content"><p class="location">Leribe District</p><h3>Bokong Nature Reserve</h3><p class="card-description">A high-altitude wetland sanctuary offering sweeping views of the Lepaqoa Valley and habitat for bearded vultures.</p><div class="card-meta"><span>Hiking</span><span>From M50 per person</span></div></div></article><article class="attraction-card"><button class="card-visual card-visual-adventure" type="button" aria-label="View Sani Pass details"><img alt="Sani Pass in Lesotho" src="./Home_files/Sani pass.ab4f29ebf6c442c8fd6e.jpg"><span class="card-category">Adventure</span></button><div class="attraction-content"><p class="location">Eastern Lesotho Border</p><h3>Sani Pass</h3><p class="card-description">A mountain pass linking Lesotho to South Africa, famous for its dramatic switchbacks and scenic alpine views.</p><div class="card-meta"><span>4x4 Drives</span><span>From M50 per person</span></div></div></article><article class="attraction-card"><button class="card-visual card-visual-nature" type="button" aria-label="View Sehlabathebe National Park details"><img alt="Sehlabathebe National Park in Lesotho" src="./Home_files/Sehlabathebe-National-Park.db77be8d712110ff6268.jpg"><span class="card-category">Nature</span></button><div class="attraction-content"><p class="location">Qacha's Nek District</p><h3>Sehlabathebe National Park</h3><p class="card-description">Lesotho's first national park, featuring sandstone arches, alpine rock pools, and rare high-altitude flora.</p><div class="card-meta"><span>Horse Riding</span><span>From M100 per person</span></div></div></article><article class="attraction-card"><button class="card-visual card-visual-adventure" type="button" aria-label="View Afriski Mountain Resort details"><img alt="Afriski Mountain Resort in Lesotho" src="./Home_files/afriski.d1cbfe61766678792123.jpg"><span class="card-category">Adventure</span></button><div class="attraction-content"><p class="location">Mahlasela Pass, Butha-Buthe District</p><h3>Afriski Mountain Resort</h3><p class="card-description">A high-altitude resort offering winter snow skiing and snowboarding alongside year-round mountain outdoor sports.</p><div class="card-meta"><span>Skiing</span><span>Activities from M250</span></div></div></article></div></section><section class="experience-band"><div class="experience-copy"><p class="eyebrow">TAKE THE SCENIC ROUTE</p><h2>Some journeys<br>stay with you.</h2><p>Ride a Basotho pony along a ridge. Share a meal in a village. Watch the clouds roll over the roof of Africa.</p><a class="button button-dark" href="http://localhost:3000/#enquiry">Plan your visit <span aria-hidden="true">↗</span></a></div></section><section class="enquiry-section section-wrap" id="enquiry"><div class="enquiry-intro"><p class="eyebrow">LET'S GET YOU THERE</p><h2>Your highland<br><em>story starts here.</em></h2><p>Tell us what you have in mind. Our local team can help you find your way.</p><div class="contact-note"><span>VISITOR INFORMATION</span><a href="mailto:info@lesothotourism.ls">info@lesothotourism.ls</a><a href="tel:+26650556445">+266 5055 6445</a></div></div><div class="enquiry-form"><form novalidate=""><div class="form-grid"><div class="form-field"><label for="name">Full name</label><input id="name" class="" aria-invalid="false" autocomplete="name" required="" placeholder="e.g. Thabo Mokoena" type="text" value="" name="name"></div><div class="form-field"><label for="email">Email address</label><input id="email" inputmode="email" class="" aria-invalid="false" autocomplete="email" required="" placeholder="you@example.com" type="text" value="" name="email"></div><div class="form-field"><label for="phone">Phone number</label><input id="phone" class="" aria-invalid="false" autocomplete="tel" required="" placeholder="+266 5XXX XXXX" type="tel" value="" name="phone"></div><div class="form-field"><label for="destination">Destination</label><select id="destination" name="destination" class="" aria-invalid="false" required=""><option value="">Choose a place</option><option value="Maletsunyane Waterfalls">Maletsunyane Waterfalls</option><option value="Thaba-Bosiu Cultural Village">Thaba-Bosiu Cultural Village</option><option value="Katse Dam">Katse Dam</option><option value="Liphofung Caves">Liphofung Caves</option><option value="Bokong Nature Reserve">Bokong Nature Reserve</option><option value="Sani Pass">Sani Pass</option><option value="Sehlabathebe National Park">Sehlabathebe National Park</option><option value="Afriski Mountain Resort">Afriski Mountain Resort</option></select></div><div class="form-field"><label for="visitors">Number of visitors</label><input id="visitors" inputmode="numeric" min="1" step="1" class="" aria-invalid="false" required="" placeholder="2" type="number" value="" name="visitors"></div><div class="form-field"><label for="date">Preferred visit date</label><input id="date" min="2026-10-11" class="" aria-invalid="false" required="" type="date" value="" name="date"></div><div class="form-field form-full"><label for="message">Your message</label><textarea id="message" name="message" rows="4" class="" aria-invalid="false" required="" placeholder="What would you like to know?"></textarea></div></div><button class="button button-dark submit-button" type="submit">Send your enquiry <span aria-hidden="true">↗</span></button></form></div></section></main><footer class="footer"><div class="footer-inner"><div class="footer-section"><a class="brand brand-footer" href="http://localhost:3000/#home"><span class="brand-mark">L</span><span>LESOTHO <small>KINGDOM IN THE SKY</small></span></a><p>Go where the mountains lead.</p></div><div class="footer-section"><h4>Find your way</h4><a href="http://localhost:3000/#about">The Kingdom</a><a href="http://localhost:3000/#destinations">Places to go</a><a href="http://localhost:3000/attractions">Attractions</a><a href="http://localhost:3000/#enquiry">Plan a visit</a></div><div class="footer-section"><h4>Say hello</h4><a href="tel:+26650556445">+266 5055 6445</a><a href="mailto:info@lesothotourism.ls">info@lesothotourism.ls</a></div></div><div class="footer-bottom"><span>© 2026 Lesotho Tourism Explorer</span><a href="http://localhost:3000/#home">Back to top ↑</a></div></footer></div></div>
